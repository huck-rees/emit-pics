# Data and figures — generated, large (pixel cubes, PDFs); never commit.
# The folders themselves are kept in-repo via committed .gitkeep placeholders,
# so a fresh clone has the expected layout while all contents stay ignored.
data/*
!data/.gitkeep
figures/*
!figures/.gitkeep
outputs/

# Ad-hoc diagnostic scripts / one-off debugging artifacts — not part of the pipeline.
troubleshooting/

# Credentials
.netrc
_netrc
credentials/

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/
*.egg

# Conda / venv
.conda/
*.conda
env/
venv/
.venv/

# Jupyter
.ipynb_checkpoints/
*.ipynb_metadata/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db
desktop.ini

# Misc
*.log
.claude/ 
